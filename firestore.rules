rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Rules for Users collection
    match /users/{userId} {
      // Allow any signed-in user to read user profiles (necessary for verification, listing, etc.)
      allow read: if isSignedIn();
      // Allow users to write/update only their own profile document
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      // Restrict deleting user profiles
      allow delete: if false;
    }

    // Rules for Classes collection
    match /classes/{classId} {
      // Allow signed-in users to read and create/update class sessions
      allow read, write: if isSignedIn();
    }

    // Rules for Attendance collection
    match /attendance/{attendanceId} {
      // Allow signed-in users to read and write attendance records
      allow read, write: if isSignedIn();
    }
  }
}
